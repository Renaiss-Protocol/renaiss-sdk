# Explicit wallet/RPC/contracts selection. Restart dev or rebuild after changing.
NEXT_PUBLIC_RENAISS_NETWORK="testnet"
# Mainnet: select "mainnet" above and use https://api.renaiss.xyz for BOTH URLs.
# Use a builder credential registered for the selected API environment.
RENAISS_API_URL="https://dev-api.renaiss.xyz"
NEXT_PUBLIC_RENAISS_API_URL="https://dev-api.renaiss.xyz"
# Server-only builder credential. Never prefix this with NEXT_PUBLIC_.
RENAISS_BUILDER_API_KEY=rnbldr_live_

# Optional: the /v2/auth/wallet URL that issues wallet access tokens, when it differs from the one derived from RENAISS_API_URL.
# RENAISS_WALLET_SESSION_ISSUER="https://dev-api.renaiss.xyz/v2/auth/wallet"

# Hosted demos must explicitly allow their own frontend origin(s), comma-separated.
# When unset, the demo proxy accepts only localhost and 127.0.0.1 on its local port.
# DEMO_ALLOWED_ORIGINS="https://your-demo.example"
